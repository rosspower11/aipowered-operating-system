# Notion — Skills Library database (Freebies)
# Create an integration at https://www.notion.so/my-integrations
# Share the Skills Library database with the integration.
NOTION_API_KEY=secret_...
NOTION_SKILLS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — only change if your Notion property names differ
# NOTION_PROP_NAME=Name
# NOTION_PROP_TAGS=Tags
# NOTION_PROP_CAMPAIGN=Campaign

# GitHub — optional override (defaults to rosspower11/aipowered-operating-system)
# GITHUB_REPO=rosspower11/aipowered-operating-system
